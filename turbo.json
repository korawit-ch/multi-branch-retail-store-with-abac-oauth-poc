{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local", "**/.env"],
  "globalEnv": [
    "NODE_ENV",
    "AUTH_COOKIE_SECRET",
    "API_PORT",
    "API_PUBLIC_URL",
    "API_INTERNAL_URL",
    "DATABASE_URL",
    "WEB_ORIGIN",
    "WEB_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_API"]
    },
    "db:generate": {
      "cache": false
    },
    "build:components": {
      "dependsOn": ["^build"]
    },
    "build:styles": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "test:e2e": {}
  }
}
